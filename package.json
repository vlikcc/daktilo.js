{
  "name": "daktilo-js",
  "version": "1.0.0",
  "description": "Zero-dependency typewriter paper aesthetic, organic ink wear & Web Audio mechanical sound engine.",
  "keywords": [
    "typewriter",
    "retro",
    "typography",
    "theme-engine",
    "webaudio",
    "paper-ui"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./samples": {
      "import": {
        "types": "./dist/samples.d.mts",
        "default": "./dist/samples.mjs"
      },
      "require": {
        "types": "./dist/samples.d.ts",
        "default": "./dist/samples.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "playground": "npm run build && node scripts/serve.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
