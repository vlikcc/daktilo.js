{
  "name": "daktilo-js",
  "version": "1.1.0",
  "description": "Zero-dependency typewriter paper aesthetic, organic ink wear & Web Audio mechanical sound engine.",
  "keywords": [
    "typewriter",
    "retro",
    "typography",
    "theme-engine",
    "webaudio",
    "paper-ui",
    "typing-animation",
    "react",
    "astro",
    "tailwindcss",
    "vue",
    "svelte",
    "web-component"
  ],
  "license": "MIT",
  "author": "Veli Keçeci",
  "homepage": "https://vlikcc.github.io/daktilo.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlikcc/daktilo.js.git"
  },
  "bugs": {
    "url": "https://github.com/vlikcc/daktilo.js/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./samples": {
      "import": {
        "types": "./dist/samples.d.mts",
        "default": "./dist/samples.mjs"
      },
      "require": {
        "types": "./dist/samples.d.ts",
        "default": "./dist/samples.cjs"
      }
    },
    "./keyboards": {
      "import": {
        "types": "./dist/keyboards.d.mts",
        "default": "./dist/keyboards.mjs"
      },
      "require": {
        "types": "./dist/keyboards.d.ts",
        "default": "./dist/keyboards.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.mts",
        "default": "./dist/editor.mjs"
      },
      "require": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.mts",
        "default": "./dist/element.mjs"
      },
      "require": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.cjs"
      }
    },
    "./textures": {
      "import": {
        "types": "./dist/textures.d.mts",
        "default": "./dist/textures.mjs"
      },
      "require": {
        "types": "./dist/textures.d.ts",
        "default": "./dist/textures.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.mts",
        "default": "./dist/svelte.mjs"
      },
      "require": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.mts",
        "default": "./dist/tailwind.mjs"
      },
      "require": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./style.css": "./dist/daktilo.css",
    "./astro": "./astro/DaktiloSheet.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "astro"
  ],
  "sideEffects": [
    "./dist/element.*"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.mjs",
    "lint:pkg": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints style.css astro",
    "playground": "npm run build && node scripts/serve.mjs",
    "demo:gif": "node scripts/demo-gif.mjs",
    "docs": "typedoc",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
