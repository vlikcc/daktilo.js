---
/**
 * Astro component: renders its content on typewriter paper. Props are the core `DaktiloOptions`,
 * except event callbacks and SoundEngine objects, which cannot travel from server to browser as JSON.
 *
 *   ---
 *   import DaktiloSheet from 'daktilo-js/astro';
 *   ---
 *   <DaktiloSheet paper="vintage" animate stamp={{ docNo: '#84-A', classification: 'ARCHIVE' }}>
 *     <h1>Night Notes</h1>
 *     <p>The mark of mechanical keys on paper…</p>
 *   </DaktiloSheet>
 */
import type { DaktiloOptions } from 'daktilo-js';

type SerializableOptions = Omit<DaktiloOptions, 'sound' | 'onChar' | 'onLine' | 'onComplete'> & { sound?: boolean };

interface Props extends SerializableOptions {
  /** Tag rendered as the paper. Default: 'article' */
  as?: string;
  class?: string;
  id?: string;
}

const { as: Tag = 'article', class: className, id, ...options } = Astro.props;
---

<Tag class={className} id={id} data-daktilo={JSON.stringify(options)}><slot /></Tag>

<script>
  import { Daktilo } from 'daktilo-js';

  function init(): void {
    document.querySelectorAll<HTMLElement>('[data-daktilo]:not([data-daktilo-ready])').forEach((el) => {
      el.setAttribute('data-daktilo-ready', '');
      new Daktilo(el, JSON.parse(el.dataset.daktilo ?? '{}'));
    });
  }

  init();
  // With View Transitions, sheets on newly loaded pages start too.
  document.addEventListener('astro:page-load', init);
</script>
